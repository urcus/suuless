PORT=8080
BIND_ADDRESS=127.0.0.1
ALLOW_REGISTRATION=true

# Empty: use SQLite at DATABASE (container default: /data/stopclop.db).
# Set only after migrating existing data; never commit the real connection URL.
# DATABASE_URL=postgresql://suuless:URL_ENCODED_PASSWORD@db.example.com:5432/suuless?sslmode=verify-full
DATABASE_URL=

# Optional first administrator, also on an existing database without an admin; password: 12–256 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Empty: configure SMTP in the admin UI. true/false: environment takes priority.
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_PUBLIC_URL=
