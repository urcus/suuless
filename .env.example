PORT=8080
BIND_ADDRESS=127.0.0.1
ALLOW_REGISTRATION=true

# Optional first administrator, also on an existing database without an admin; password: 12–256 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Empty: configure SMTP in the admin UI. true/false: environment takes priority.
SMTP_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_PUBLIC_URL=
